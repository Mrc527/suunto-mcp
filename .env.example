# MCP for PADI, local (single-user) mode. Set these in your MCP client configuration (the "env"
# block of the server) or in your shell. The server does not read a .env file by itself. To keep
# them in a file, copy this one to .env (never commit it) and start the server with Node's
# --env-file option (use the absolute path to the file in an MCP client configuration):
#   node --env-file=.env dist/index.js --check
# The web service (--web) does not use these: each user connects their own PADI account on the
# account page. See README.md for every option.

# The e-mail and password you sign in to PADI with (learning.padi.com).
# Accounts that sign in with Google, Apple or Facebook must first set a PADI password
# ("Forgot password" on account.padi.com).
PADI_EMAIL=you@example.com
PADI_PASSWORD=your-padi-password
# Or read the password from a file:
# PADI_PASSWORD_FILE=/run/secrets/padi_password

# Instead of the password: a PADI refresh token (or PADI_REFRESH_TOKEN_FILE).
# PADI_REFRESH_TOKEN=

# Keep the current refresh token in this file (mode 0600), so the next start needs no password.
# Default: memory only (every start signs in again with the password).
# PADI_TOKEN_CACHE=/home/you/.config/padi-mcp/token.json

# Optional
# PADI_UNITS=auto            # auto (your PADI logbook setting) | metric | imperial
# PADI_READ_ONLY=false       # true: no tools that add, change or delete dives
# PADI_TIMEZONE=Europe/Zurich  # the server's "today" (padi_account_info, Year in review)
# PADI_LOGIN_METHOD=auto     # auto | cognito | padi
# PADI_API_MODE=proxy        # proxy | direct | auto (try "auto" or "direct" if PADI changes its API)

# HTTP mode (node dist/index.js --http)
# MCP_HTTP_TOKEN=change-me-to-a-long-random-string
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
