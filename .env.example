# MCP for Suunto, local (single-user) mode. Set these in your MCP client configuration (the "env"
# block of the server) or in your shell. The server does not read a .env file by itself. To keep
# them in a file, copy this one to .env (never commit it) and start the server with Node's
# --env-file option (use the absolute path to the file in an MCP client configuration):
#   node --env-file=.env dist/index.js --check
# The web service (--web) does not use the token settings below: each user connects their own
# Suunto account on the account page. See README.md for every option.

# The keys of your own app in the Suunto API Zone (https://apizone.suunto.com, Profile > OAuth
# settings, and the subscription key of your API subscription). All three are required.
SUUNTO_CLIENT_ID=your-client-id
SUUNTO_CLIENT_SECRET=your-client-secret
SUUNTO_SUBSCRIPTION_KEY=your-subscription-key
# Or read the secret and the key from files:
# SUUNTO_CLIENT_SECRET_FILE=/run/secrets/suunto_client_secret
# SUUNTO_SUBSCRIPTION_KEY_FILE=/run/secrets/suunto_subscription_key

# File with the current Suunto tokens (mode 0600). "suunto-mcp --login" writes it once; later
# starts read it and keep it up to date. A leading ~ is your home folder. Several programs can
# share the file, and a running server picks up a new --login without a restart. If the file is
# there but cannot be used (damaged, or written for another SUUNTO_CLIENT_ID), the server does
# not start and names the file (with SUUNTO_REFRESH_TOKEN set, it only warns and uses that).
# Default: memory only.
SUUNTO_TOKEN_CACHE=~/.config/suunto-mcp/tokens.json

# Instead of the token cache: a Suunto refresh token (or SUUNTO_REFRESH_TOKEN_FILE).
# SUUNTO_REFRESH_TOKEN=

# Only for "suunto-mcp --login": where Suunto sends you back after you allow access. It must be
# a loopback http address, and it must be registered as the redirect URI of your app in the
# Suunto API Zone.
# SUUNTO_REDIRECT_URI=http://localhost:8723/callback

# Optional
# SUUNTO_UNITS=metric          # metric | imperial
# SUUNTO_READ_ONLY=false       # true: no tools that add routes or points of interest
# SUUNTO_TIMEZONE=Europe/Zurich  # your time zone: calendar dates and "today" (default: system)

# Limits of the requests to Suunto from this process (0 means no limit, empty means the
# default). SUUNTO_CALLS_PER_MINUTE: at most this many in any 60 seconds (default 10, the limit
# of Suunto's Developer API). SUUNTO_CALLS_PER_USER_PER_DAY: at most this many per UTC day
# (default 0, no limit). SUUNTO_CALLS_PER_USER_PER_WEEK: at most this many in any 7 days
# (default 0, no limit). Raise SUUNTO_CALLS_PER_MINUTE after Suunto accepts your Production
# subscription.
# SUUNTO_CALLS_PER_MINUTE=10
# SUUNTO_CALLS_PER_USER_PER_DAY=0
# SUUNTO_CALLS_PER_USER_PER_WEEK=0

# HTTP mode (node dist/index.js --http)
# MCP_HTTP_TOKEN=change-me-to-a-long-random-string
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
