# Settings for deploy/docker-compose.yml (MCP for Suunto). Copy to .env and edit.
# Put a value in single quotes if it contains a $ sign, for example ADMIN_PASSWORD='abc$123'.

# Public host name (needs a DNS A record pointing at this machine; ports 80 and 443 open).
DOMAIN=suunto-mcp.example.com

# Administrator account, created on the first start. Set BOTH values before you start the
# service: with only one of them (or none), the first person who signs up on https://DOMAIN
# becomes the administrator. The password needs at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The keys of your app in the Suunto API Zone (https://apizone.suunto.com): the client id and
# client secret from Profile > OAuth settings, and the subscription key of your API
# subscription. Set all three or none. Without them the service starts and demo accounts work,
# but real accounts cannot connect Suunto. Register https://DOMAIN/suunto/callback as the
# redirect URI of the app. See "Suunto API Zone setup" in README.md.
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=
# Optional: another redirect URI. Default: https://DOMAIN/suunto/callback.
#SUUNTO_REDIRECT_URI=

# Optional: 32-byte key (64 hex characters) that encrypts the stored Suunto tokens. If empty,
# one is generated in the data volume. Back it up either way.
#MASTER_KEY=

# Optional: e-mails to administrators about new access requests, through your own SMTP server
# (smtps://, or smtp:// with STARTTLS). NOTIFY_FROM is needed when the SMTP user name is not an
# e-mail address.
#SMTP_URL=smtps://user:password@mail.example.com:465
#NOTIFY_FROM=suunto-mcp@example.com
