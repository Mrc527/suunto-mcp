# Settings for the MCP for PADI service on this server. Copy this file to .env and edit it:
#   cp .env.example .env && chmod 600 .env
#
# Put a value in single quotes if it contains a $ sign, for example ADMIN_PASSWORD='abc$123'.
# Without quotes Docker Compose would treat $123 as a variable and change the value.

# Public host name of the service. Claude connects to https://DOMAIN/mcp, so DOMAIN needs a
# DNS record pointing at this server and a valid HTTPS certificate on port 443. The service
# needs its own host name: it cannot share one with another site.
DOMAIN=padi-mcp.example.com

# Only for a reverse proxy installed on this machine (nginx, Caddy): the local port the service
# listens on, published by compose.override.yml (setup-server.sh writes it). A proxy in Docker
# such as Traefik needs no port: it reaches the service over a shared Docker network.
# Each service on this machine needs its own port: if another one already uses 3000, take 3001.
#HOST_PORT=3000
# Listen address on this machine, with HOST_PORT. Keep 127.0.0.1 when the proxy runs on this
# machine. If you change it, use an address only your proxy can reach and allow HOST_PORT only
# from the proxy in your cloud firewall: ports published by Docker skip the host firewall (ufw,
# iptables), and with TRUST_PROXY set, anyone who reaches the port directly can fake their IP
# address.
#BIND_ADDRESS=127.0.0.1

# Number of reverse proxies in front of the service (for example 2 for Cloudflare + nginx).
TRUST_PROXY=1

# Administrator account, created on the first start. Set BOTH values: with only one of them (or
# none), the first person who signs up on https://DOMAIN becomes the administrator. The password
# needs at least 10 characters. You can remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: 32-byte key (64 hex characters) that encrypts the stored PADI sign-ins (refresh
# tokens). If empty, one is generated in the data volume. Back it up either way.
MASTER_KEY=

# Optional: e-mails to administrators about new access requests, through your own SMTP server
# (for example smtps://user:password@mail.example.com:465). Without it no e-mail is sent; the
# admin page still lists the requests. The server does not start if SMTP_URL is not a valid
# smtp:// or smtps:// address. The connection must be encrypted: smtps://, or smtp:// with
# STARTTLS (add ?requireTLS=false only for a mail server on the same machine without TLS).
# NOTIFY_FROM is the sender address; default: the SMTP user name when it is an e-mail address.
# If it is not, set NOTIFY_FROM to an address your SMTP server may send from: the server does
# not start without one.
#SMTP_URL=
#NOTIFY_FROM=

# Optional: which PADI logbook API every user's connection uses: proxy | direct | auto.
# Default proxy. Try auto or direct if PADI changes its logbook API (see Troubleshooting in
# README.md). After a change, run docker compose up -d.
#PADI_API_MODE=proxy

# Uncomment if this server has no reverse proxy yet: the bundled Caddy then serves HTTPS on
# ports 80 and 443 with an automatic Let's Encrypt certificate.
#COMPOSE_PROFILES=caddy

# Managed by deploy.sh (the image that runs now). Do not edit.
#PADI_MCP_IMAGE=
