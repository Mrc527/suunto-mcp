# Example nginx site for the web mode of MCP for PADI (TLS certificates managed separately,
# e.g. certbot). Run the server with:
#   PUBLIC_URL=https://padi-mcp.example.com TRUST_PROXY=1 node dist/index.js --web
# With the Docker deploy (deploy/server), the service gets a local port only when
# compose.override.yml publishes one (setup-server.sh, answer "host"): use the HOST_PORT of .env
# in proxy_pass (3000 unless another service already uses that port on the same machine).
server {
    listen 443 ssl http2;
    server_name padi-mcp.example.com;

    ssl_certificate     /etc/letsencrypt/live/padi-mcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/padi-mcp.example.com/privkey.pem;

    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Tool calls (a full logbook export, dive photos, a slow PADI API) can take a while.
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
